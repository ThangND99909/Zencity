# Required on production (Render/ENVIRONMENT=production)
ADMIN_PASSCODE=replace-with-a-private-admin-passcode
ADMIN_AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_SECONDS=28800
ALLOWED_ORIGINS=https://zencity-smartcalendar.pages.dev

# BẮT BUỘC đặt đúng khi chạy sau proxy, nếu không cơ chế chặn dò passcode sẽ sai.
#   0 = không có proxy (bỏ qua X-Forwarded-For — mặc định, an toàn)
#   1 = chạy thẳng sau Render/Railway/nginx
#   2 = có thêm Cloudflare đứng trước
# Đặt SAI thành 0 khi thực tế có proxy ⇒ mọi người dùng bị gộp chung 1 hạn mức.
# Đặt CAO hơn số proxy thật ⇒ kẻ tấn công giả mạo được IP và thoát giới hạn.
TRUSTED_PROXY_COUNT=1

# Lưới an toàn: tổng số lần nhập sai trong 5 phút trên toàn hệ thống.
ADMIN_GLOBAL_MAX_ATTEMPTS=100

# Existing service configuration
GOOGLE_SERVICE_ACCOUNT=
OPENAI_API_KEY=
GEMINI_API_KEY=
